{
  "name": "luach",
  "version": "1.0.0",
  "private": true,
  "description": "לוח — פלטפורמת לוח מודעות ישראלית",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "e2e": "node scripts/e2e-check.mjs",
    "check:format": "tsx scripts/checks/format-check.ts",
    "check:seed": "tsx scripts/checks/seed-check.ts",
    "check:search": "tsx scripts/checks/search-check.ts",
    "check:all": "npm run check:format && npm run check:search && npm run check:risk",
    "check:risk": "tsx scripts/checks/risk-check.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
