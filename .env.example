# ---------------------------------------------------------------------------
# לוח — משתני סביבה
# העתק לקובץ .env ומלא את הערכים
# ---------------------------------------------------------------------------

# --- בסיס נתונים (Neon / Supabase / Postgres מקומי) ---
# ב-Neon: השתמש ב-connection string עם pooler עבור DATABASE_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luach?schema=public"
# חיבור ישיר (ללא pooler) — נדרש להרצת מיגרציות ב-Neon/Supabase.
# אם אתה משתמש ב-Postgres רגיל, שים את אותו ערך כמו DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/luach?schema=public"

# --- Auth.js (NextAuth v5) ---
# צור מפתח: openssl rand -base64 32
AUTH_SECRET="change-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Google OAuth (אופציונלי) ---
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- SMS / OTP ---
# כשריק — הקוד נכתב ללוג השרת ומוחזר בתגובה בסביבת פיתוח (מוק).
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER="Luach"

# --- העלאת תמונות ---
# ספק: "local" (ברירת מחדל בפיתוח) | "cloudinary" | "uploadthing"
UPLOAD_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
UPLOADTHING_TOKEN=""

# --- מיילים (Resend) ---
# כשריק — המיילים נכתבים ללוג במקום להישלח.
RESEND_API_KEY=""
EMAIL_FROM="לוח <noreply@example.com>"

# --- Rate limiting (Upstash Redis) ---
# כשריק — נעשה שימוש במגביל בזיכרון התהליך (מתאים לפיתוח בלבד).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Web Push (PWA) ---
# צור מפתחות: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# --- כללי ---
# כתובת הבסיס של האתר. קובעת את metadataBase, ומכאן את og:url ואת
# תמונות השיתוף — בלעדיה כל שיתוף בוואטסאפ ובפייסבוק מצביע ל-localhost.
# ב-Vercel אפשר להשמיט: הקוד נופל אחורה ל-VERCEL_PROJECT_PRODUCTION_URL.
# בפרודקשן בלי סלאש בסוף, לדוגמה https://luach.example.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="לוח"
# מפתח משותף להרצת משימות מתוזמנות (cron) דרך HTTP
CRON_SECRET=""
