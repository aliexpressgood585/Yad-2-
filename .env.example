# ============================================================================
#  כדאי — משתני סביבה
#
#  מה שמסומן [חובה] חייב להיות מוגדר ב-Vercel לפני שמשתמשים אמיתיים
#  נכנסים. השאר משפר, אבל האתר עולה בלעדיו.
# ============================================================================

# --- מסד נתונים ----------------------------------------------------------
# [חובה] Postgres 16 ומעלה. בספק עם pgBouncer זו הכתובת המאוגמת.
DATABASE_URL="postgresql://user:pass@host:5432/kedai?schema=public"
# [חובה] חיבור ישיר, בלי pgBouncer — Prisma משתמש בו למיגרציות בלבד.
DIRECT_URL="postgresql://user:pass@host:5432/kedai?schema=public"

# --- זהות האתר ------------------------------------------------------------
# [חובה] הדומיין הציבורי, בלי לוכסן בסוף. ממנו נגזרים og:url, canonical
# וכתובות החזרה מהסליקה. בלעדיו הכול מצביע ל-localhost.
NEXT_PUBLIC_SITE_URL="https://kedai.co.il"

# --- אימות ----------------------------------------------------------------
# [חובה] מפתח החתימה של NextAuth. ליצירה: openssl rand -base64 32
AUTH_SECRET=""
# התחברות עם גוגל. אופציונלי — בלעדיו נשארים אימייל+סיסמה ו-SMS.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- SMS ------------------------------------------------------------------
# [חובה] בלי זה אף אחד לא מאמת טלפון, ובלי טלפון מאומת אף אחד לא
# מפרסם מודעה. זה השירות שחוסם הכול.
# ערכים: 019 | inforu | twilio
SMS_PROVIDER=""
# שם השולח שמופיע במכשיר. עד 11 תווים לטיניים.
SMS_SENDER="Kedai"

# 019 (ישראלי)
SMS_019_USERNAME=""
SMS_019_TOKEN=""

# Inforu (ישראלי)
SMS_INFORU_USERNAME=""
SMS_INFORU_TOKEN=""

# Twilio (בינלאומי — שיעור מסירה נמוך יותר בישראל)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- אחסון תמונות ---------------------------------------------------------
# [חובה] בלי זה התמונות נשמרות ב-public/uploads ונעלמות בכל פריסה,
# כי מערכת הקבצים ב-Vercel אינה נשמרת בין הרצות.
UPLOAD_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- דוא"ל ----------------------------------------------------------------
# [חובה להתראות] Resend. הדומיין חייב להיות מאומת אצלם עם SPF ו-DKIM,
# אחרת ההודעות נוחתות בספאם ואף אחד לא חוזר ללוח.
RESEND_API_KEY=""
EMAIL_FROM="כדאי <noreply@kedai.co.il>"

# --- התראות דחיפה ---------------------------------------------------------
# ליצירה: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@kedai.co.il"

# --- Redis ----------------------------------------------------------------
# [חובה] Upstash. הגבלת קצב בזיכרון אינה עובדת ב-serverless — כל
# הפעלה מקבלת מונה חדש, כלומר אין הגבלה בפועל.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- סליקה ----------------------------------------------------------------
# בלי זה חבילות הקידום מופעלות בלי תשלום (מצב פיתוח בלבד).
# ערכים: tranzila
PAYMENT_PROVIDER=""
TRANZILA_TERMINAL=""
TRANZILA_API_KEY=""
TRANZILA_API_SECRET=""

# --- ניטור ----------------------------------------------------------------
# Sentry. בלעדיו שגיאות פרודקשן נעלמות בלוגים של Vercel.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# --- משימות מתוזמנות -------------------------------------------------------
# [חובה] סוד שמגן על /api/cron. בלעדיו כל אחד יכול להריץ את התחזוקה.
CRON_SECRET=""

# --- מפתח AI --------------------------------------------------------------
# לניסוח מודעה אוטומטי. אופציונלי — הפיצ'ר מוסתר בלעדיו.
ANTHROPIC_API_KEY=""

# --- נתוני הדגמה ----------------------------------------------------------
# להשאיר ריק בפרודקשן. "true" חושף את מודעות הדמו, שהטלפונים שלהן
# אינם קיימים — משתמש שמתקשר אליהן מאבד את האמון בלוח.
ALLOW_DEMO_DATA=""

# --- זריעה ----------------------------------------------------------------
# שסתום בטיחות: הזריעה מסרבת לרוץ מול מסד שאינו מקומי אלא אם המארח
# נרשם כאן במפורש. אל תגדיר בפרודקשן.
SEED_TARGET_OK=""

# --- CI בלבד --------------------------------------------------------------
# כותב את קוד האימות ללוג השרת גם בפרודקשן, כדי שבדיקת הקבלה תוכל
# לקרוא אותו. **אל תגדיר בפרודקשן אמיתי** — קוד אימות בלוג הוא קוד
# שכל מי שקורא לוגים יכול להתחזות איתו.
SMS_ECHO_TO_LOG=""
